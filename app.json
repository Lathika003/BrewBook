{
  "expo": {
    "name": "BrewBook",
    "slug": "brewbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brewbook-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "brewbook",
    "backgroundColor": "#F5EBDD",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#34251D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.brewbook.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EBDD",
          "image": "./assets/brewbook-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font"
    ]
  }
}
